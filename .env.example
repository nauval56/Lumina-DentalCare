# ==============================================================================
# LUMINA DENTAL CARE — ENVIRONMENT VARIABLES EXAMPLE
# Salin file ini menjadi .env dan isi dengan kredensial aktual Anda.
# JANGAN PERNAH mengunggah file .env ke repository Git.
# ==============================================================================

# 1. Database TiDB Cloud (MySQL-compatible dengan TLS/SSL wajib)
# Gunakan connection string resmi dari dashboard TiDB Cloud Anda:
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:4000/DATABASE_NAME?sslaccept=strict"

# 2. Keamanan Sesi & Autentikasi (minimal 32 karakter acak untuk produksi)
SESSION_SECRET="ganti-dengan-secret-acak-minimal-32-karakter-untuk-produksi"

# 3. URL Aplikasi Publik
NUXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Payment Gateway
# Gunakan "mock" untuk development/simulasi (ditandai jelas bukan pembayaran nyata).
# Isi kredensial provider nyata jika ingin menghubungkan payment gateway produksi.
PAYMENT_GATEWAY_PROVIDER="mock"
PAYMENT_GATEWAY_SERVER_KEY=""
PAYMENT_WEBHOOK_SECRET="ganti-dengan-webhook-secret-dari-payment-gateway"

# 5. Konfigurasi Gmail SMTP untuk Pengiriman Email Reset Password
# Buat 16-digit App Password di Akun Google: https://myaccount.google.com/apppasswords
GMAIL_USER="email.klinik.anda@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_FROM_NAME="Lumina Dental Care"
